# Local development configuration. Copy to src/.env and supply real values.
SCENARIO=default
EXCLUDED_AGENTS=MedicalResearch,Radiology

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://example.openai.azure.com/
AZURE_OPENAI_API_ENDPOINT=https://example.openai.azure.com/
AZURE_OPENAI_REASONING_MODEL_ENDPOINT=https://example.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_DEPLOYMENT_NAME_REASONING_MODEL=gpt-4.1

# Application storage and generated deployment metadata
APP_BLOB_STORAGE_ENDPOINT=https://examplestorage.blob.core.windows.net/
BOT_IDS={}
HLS_MODEL_ENDPOINTS={}

# Clinical note source: blob, fhir, or fabric
CLINICAL_NOTES_SOURCE=blob
FHIR_SERVICE_ENDPOINT=
FABRIC_USER_DATA_FUNCTION_ENDPOINT=

# Access control. Replace wildcard values before a production deployment.
ADDITIONAL_ALLOWED_TENANT_IDS=*
ADDITIONAL_ALLOWED_USER_IDS=*

# Optional integrations
GRAPH_RAG_SUBSCRIPTION_KEY=
APPLICATIONINSIGHTS_CONNECTION_STRING=
